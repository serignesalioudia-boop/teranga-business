# ============================================================
# TERANGA BUSINESS — EXEMPLE DE VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS commiter de vraies valeurs.
# ============================================================

# --- Base de données (PostgreSQL) ---
POSTGRES_USER=teranga
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=teranga_business
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# --- Authentification (Auth.js) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=remplacez_par_une_longue_chaine_aleatoire

# --- Images (Cloudinary) — à fournir lors de la mise en production ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Brevo / SMTP) — à fournir lors de la mise en production ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Teranga Business <no-reply@terangabusiness.sn>"

# --- Paiements — clés TEST puis PRODUCTION, fournies ultérieurement ---
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
CARD_PROVIDER_API_KEY=
