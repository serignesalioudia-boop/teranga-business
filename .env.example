# ============================================================
# TERANGA BUSINESS — ENVIRONNEMENT PRODUCTION
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Base de données (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# --- Authentification ---
NEXTAUTH_URL="https://[YOUR-DOMAIN].vercel.app"
NEXTAUTH_SECRET="[GÉNÉRER: openssl rand -hex 32]"

# --- Cloudinary (médias produits / boutiques) ---
CLOUDINARY_CLOUD_NAME="[VOTRE-CLÉ]"
CLOUDINARY_API_KEY="[VOTRE-CLÉ]"
CLOUDINARY_API_SECRET="[VOTRE-CLÉ]"

# --- Email (SMTP) ---
SMTP_HOST="smtp.gmail.com" ou "smtp-brevo.com"
SMTP_PORT=587
SMTP_USER="[VOTRE-EMAIL]"
SMTP_PASSWORD="[VOTRE-MOT-DE-PASSE-APPLI]"
SMTP_FROM="Teranga Business <no-reply@terangabusiness.sn>"

# --- Webhook secrets (paiement) ---
WAVE_WEBHOOK_SECRET="[CONFIGURER-CÔTÉ-WAVE]"
ORANGE_WEBHOOK_SECRET="[CONFIGURER-CÔTÉ-ORANGE]"
WAVE_API_KEY=""
WAVE_MERCHANT_ID=""
WAVE_RETURN_URL=""
WAVE_CANCEL_URL=""
ORANGE_API_URL=""
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
ORANGE_MERCHANT_KEY=""
ORANGE_RETURN_URL=""
ORANGE_CANCEL_URL=""
